{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build --webpack",
    "vercel-build": "npm run db:validate && npm run test:tenant-schema && prisma generate && prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:tenant-schema": "node scripts/check-tenant-schema.mjs",
    "check": "npm run db:validate && npm run test:tenant-schema && npm run typecheck && npm run lint",
    "setup": "prisma generate && prisma validate && node scripts/check-tenant-schema.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.4",
    "@dnd-kit/core": "6.3.1",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.544.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
