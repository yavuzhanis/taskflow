# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase Postgres
# Use the transaction pooler URL for the running app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Use the direct/session connection for Prisma schema commands.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Admin configuration (comma-separated admin emails)
ADMIN_EMAILS=admin@example.com

# Vercel Cron
# Generate a long random value and add it to Vercel Production env vars.
CRON_SECRET=replace_with_a_long_random_secret

# Optional SMTP email notifications for completed tasks.
# Leave these unset to disable automatic email sending.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_STARTTLS=true
# SMTP_USER=sender@example.com
# SMTP_PASSWORD=replace_with_mail_password_or_app_password
# SMTP_FROM_EMAIL=sender@example.com
# SMTP_FROM_NAME=TaskFlow
# TASK_COMPLETION_EMAIL_TO=office@example.com
# TASK_COMPLETION_EMAIL_CC=
